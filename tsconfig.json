{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "Bundler",

    // Required until this issue is resolved
    // https://github.com/microsoft/TypeScript/issues/52460
    "paths": {
      "#*": ["./src/*"]
    },

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "env.d.ts"]
}
