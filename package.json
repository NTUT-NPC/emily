{
  "name": "emily-js",
  "version": "0.1.0",
  "packageManager": "pnpm@12.16.1",
  "description": "北科程式設計研究社 (NPC) 的 Discord 社群管理工具，舊 Emily 的 Discord.js 重製版。",
  "imports": {
    "#*": "./src/*"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "tsx --watch src/main.ts",
    "build": "tsx build.ts",
    "type-check": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "discord.js": "^14.28.0",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-format": "2.0.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
