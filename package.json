{
  "name": "emily-js",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@9.7.1",
  "description": "北科程式設計研究社 (NPC) 的 Discord 社群管理工具，舊 Emily 的 Discord.js 重製版。",
  "engines": {
    "node": ">=20.16.0"
  },
  "scripts": {
    "dev": "tsx --watch src/main.ts",
    "build": "tsx build.ts",
    "postinstall": "prisma generate --no-hints",
    "type-check": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "discord.js": "^14.15.3",
    "prisma": "^5.18.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.26.0",
    "esbuild": "^0.23.1",
    "eslint": "^9.9.0",
    "eslint-plugin-format": "^0.1.2",
    "tsx": "^4.17.0",
    "typescript": "5.5.4"
  },
  "imports": {
    "#*": "./src/*"
  }
}
